# Terraform
.terraform/
# Keep lock file for reproducibility
# .terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Sensitive
*.pem
*.key
commit.txt
logs
tfplan
main.tf.bak

# Saved plans can contain sensitive values.
*.tfplan

# Reviewed non-secret public release desired state.
!release-activation.auto.tfvars.json
